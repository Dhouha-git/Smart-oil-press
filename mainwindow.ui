         <property name="styleSheet">
          <string notr="true">/* ====== GroupBox ====== */
QGroupBox {
    border: 2px solid #C8A951;
    border-radius: 10px;
    margin-top: 15px;
    padding: 15px;
    font-weight: bold;
    font-size: 14px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 20px;
    padding: 0 8px;
    color: #444;
}

/* ====== LineEdit ====== */
QLineEdit {
    border: 2px solid #C8A951;
    border-radius: 6px;
    padding: 5px;
    background-color: white;
    min-height: 28px;
}

QLineEdit:focus {
    border: 2px solid #556B2F;
}

/* ====== ComboBox ====== */
QComboBox {
    border: 2px solid #C8A951;
    border-radius: 6px;
    padding: 5px;
    background-color: white;
    min-height: 28px;
}

QComboBox:hover {
    border: 2px solid #556B2F;
}

QComboBox::drop-down {
    border: none;
    width: 25px;
}

QComboBox::down-arrow {
    image: none;
    width: 10px;
    height: 10px;
}

/* ====== DateEdit ====== */
QDateEdit {
    border: 2px solid #C8A951;
    border-radius: 6px;
    padding: 5px;
    background-color: white;
    min-height: 28px;
}

QDateEdit:focus {
    border: 2px solid #556B2F;
}

/* ====== PushButton ====== */
QPushButton {
    background-color: #556B2F;
    color: white;
    border-radius: 8px;
    padding: 8px 20px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #6B8E23;
}

QPushButton:pressed {
    background-color: #3E4E1F;
}
</string>
