      <property name="styleSheet">
       <string notr="true">
QWidget {
    background: #ffffff;
    font-family: &quot;Segoe UI&quot;, &quot;Arial&quot;;
    font-size: 11pt;
    color: #111111;
}

/* Optional: better default focus behavior */
*:focus {
    outline: none; /* Qt ignores CSS outline mostly, but keep clean */
}

/* =========================================================
   COLORS (keep consistent)
   =========================================================
   Accent (orange): #c78a10
   Accent dark:     #a66f08
   Accent light:    #f3d08a
   Border neutral:  #bdbdbd
*/
 
/* =========================================================
   GROUPBOX
   ========================================================= */
QGroupBox {
    border: 2px solid #c78a10;
    border-radius: 14px;
    margin-top: 18px;              /* space for title */
    padding: 16px 14px 12px 14px;  /* inside spacing */
    background: transparent;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;

    left: 16px;
    padding: 0 10px;

    font-weight: 700;
    font-size: 12pt;
    color: #111111;

    background: #ffffff; /* cuts border behind title */
}

/* =========================================================
   LABELS
   ========================================================= */
QLabel {
    font-weight: 700;
    color: #111111;
}

/* =========================================================
   LINE EDIT (text fields)
   ========================================================= */
QLineEdit {
    background: #ffffff;
    border: 2px solid #c78a10;
    border-radius: 6px;
    padding: 6px 10px;
    selection-background-color: #c78a10;
    selection-color: #ffffff;
}

QLineEdit:hover {
    border-color: #a66f08;
}

QLineEdit:focus {
    border-color: #a66f08;
}

QLineEdit:disabled {
    background: #f4f4f4;
    border-color: #d6b56f;
    color: #888888;
}

/* =========================================================
   COMBOBOX
   ========================================================= */
QComboBox {
    background: #ffffff;
    border: 2px solid #c78a10;
    border-radius: 6px;
    padding: 6px 34px 6px 10px;  /* right padding to avoid overlap with arrow */
}

QComboBox:hover {
    border-color: #a66f08;
}

QComboBox:focus {
    border-color: #a66f08;
}

QComboBox:disabled {
    background: #f4f4f4;
    border-color: #d6b56f;
    color: #888888;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 28px;

    border-left: 2px solid #c78a10;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    background: #ffffff;
}

QComboBox:hover::drop-down {
    border-left-color: #a66f08;
}

/* Arrow: QSS cannot draw a real arrow without an image.
   This is a simple “chevron” using borders via an indicator trick is not supported for QComboBox.
   Best option: provide an SVG/PNG. Replace with your resource path.
*/
QComboBox::down-arrow {
    image: url(:/icons/chevron-down.png); /* &lt;-- put your icon in Qt resources */
    width: 12px;
    height: 12px;
}

/* Dropdown list */
QComboBox QAbstractItemView {
    border: 2px solid #c78a10;
    background: #ffffff;
    selection-background-color: #f3d08a;
    selection-color: #111111;
    outline: none;
}

/* =========================================================
   DATEEDIT / SPINBOX
   ========================================================= */
QDateEdit, QSpinBox, QDoubleSpinBox {
    background: #ffffff;
    border: 2px solid #c78a10;
    border-radius: 6px;
    padding: 6px 34px 6px 10px; /* space for buttons */
}

QDateEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: #a66f08;
}

QDateEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #a66f08;
}

QDateEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled {
    background: #f4f4f4;
    border-color: #d6b56f;
    color: #888888;
}

/* Buttons area */
QDateEdit::up-button, QSpinBox::up-button, QDoubleSpinBox::up-button,
QDateEdit::down-button, QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    width: 28px;
    background: #ffffff;
    border-left: 2px solid #c78a10;
}

QDateEdit::up-button, QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-position: top right;
    border-top-right-radius: 6px;
}

QDateEdit::down-button, QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-position: bottom right;
    border-bottom-right-radius: 6px;
}

QDateEdit:hover::up-button, QSpinBox:hover::up-button, QDoubleSpinBox:hover::up-button,
QDateEdit:hover::down-button, QSpinBox:hover::down-button, QDoubleSpinBox:hover::down-button {
    border-left-color: #a66f08;
}

QDateEdit::up-arrow, QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(:/icons/chevron-up.png);
    width: 10px;
    height: 10px;
}

QDateEdit::down-arrow, QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(:/icons/chevron-down.png);
    width: 10px;
    height: 10px;
}

/* =========================================================
   PUSH BUTTON
   ========================================================= */
QPushButton {
    background: #f5f5f5;
    border: 1px solid #bdbdbd;
    border-radius: 6px;
    padding: 7px 16px;
}

QPushButton:hover {
    background: #eeeeee;
    border-color: #a9a9a9;
}

QPushButton:pressed {
    background: #e4e4e4;
}

QPushButton:disabled {
    background: #f2f2f2;
    border-color: #d0d0d0;
    color: #9a9a9a;
}

/* =========================================================
   TOOLTIP
   ========================================================= */
QToolTip {
    background: #ffffff;
    color: #111111;
    border: 1px solid #c78a10;
    padding: 6px 8px;
    border-radius: 6px;
}

/* Fond du formulaire */
#InformationsPersonnelles_2 {
    background-color: #faf8f4;
}

/* Bouton principal */
QPushButton#ajouter {
    background-color: #4a5c25;
    color: #ffffff;
    border: 1px solid #3d4d1f;
    font-weight: 700;
    border-radius: 8px;
    padding: 8px 14px;
}
QPushButton#ajouter:hover {
    background-color: #5d7230;
    border-color: #4a5c25;
}
QPushButton#ajouter:pressed {
    background-color: #3d4d1f;
}

QPushButton#modifier, QPushButton#suprimer, QPushButton#afficher {
    border-radius: 8px;
    padding: 7px 12px;
    font-weight: 600;
}
QPushButton#modifier {
    background-color: #fff9ed;
    border: 2px solid #c78a10;
    color: #5c4006;
}
QPushButton#modifier:hover {
    background-color: #f3d08a;
}
QPushButton#suprimer {
    background-color: #fff5f5;
    border: 2px solid #c62828;
    color: #b71c1c;
}
QPushButton#suprimer:hover {
    background-color: #ffcdd2;
}
QPushButton#afficher {
    background-color: #e8f4ea;
    border: 2px solid #4a5c25;
    color: #2e3d18;
}
QPushButton#afficher:hover {
    background-color: #c8e6c9;
}
