       <string notr="true">QTableWidget {
    background-color: #6f8438;
    gridline-color: #d6b25e;
    border: 1px solid #d6b25e;
    border-radius: 10px;
}

QTableWidget::item {
    padding: 6px;
}

QTableWidget::item:selected {
    background-color: #d6b25e;
    color: #3b3b3b;
}

/* Header */
QHeaderView::section {
    background-color: #4a5c25;
    color: white;
    padding: 6px;
    border: 1px solid #d6b25e;
    font-weight: bold;
}

/* =========================
   SCROLLBAR
========================= */
QScrollBar:vertical {
    background: #4a5c25;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #d6b25e;
    border-radius: 6px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #ffd978;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    background: none;
    height: 0;
}

