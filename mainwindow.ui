        <string notr="true">/* Dialog principal */
QWidget {
    background-color: #F5F5F5;
}
QLabel#label_6 {
    border-image: url(:/images/login-removebg-preview.png);
}

QLabel#label_5 {
    border-image: url(:/images/lg-removebg-preview.png);
}


/* Titre */
QLabel#label_3{
    color: #556B2F;
    font-size: 28px;
    font-weight: bold;
    background-color: transparent;
}

/* Labels */
QLabel {
    color: #6B4F3F;
    font-size: 16px;
    font-weight: bold;
    background-color: transparent;
}

/* Inputs */
QLineEdit {
    border: 2px solid #D4AF37;
    border-radius: 8px;
    padding: 12px;
    font-size: 14px;
    background-color: white;
    color: #333333;
}

QLineEdit:focus {
    border: 2px solid #556B2F;
}

/* Checkbox */
QCheckBox {
    color: #6B4F3F;
    font-size: 13px;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #D4AF37;
    border-radius: 4px;
    background-color: white;
}

QCheckBox::indicator:checked {
    background-color: #556B2F;
    border-color: #556B2F;
    image: url(:/icons/check.png);
}

/* Button */
QPushButton {
    background-color: #556B2F;
    color: white;
    border: none;
    border-radius: 10px;
    padding: 14px;
    font-size: 16px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #6B8E23;
}

QPushButton:pressed {
    background-color: #2C3E1F;
}</string>
       </property>
