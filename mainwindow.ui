/* =========================================================
   GLOBAL TYPOGRAPHY &amp; BACKGROUND
   ========================================================= */
QWidget {
    font-family: &quot;Segoe UI&quot;, &quot;Helvetica Neue&quot;, &quot;Arial&quot;;
    font-size: 10pt;
    color: #2b2b2b;
}

#centralwidget, #page {
    background-color: #f4f5f2; /* Vert trÃ¨s, trÃ¨s pÃ¢le / gris doux pour reposer les yeux */
}

/* =========================================================
   GROUPBOX (LES CARTES)
   ========================================================= */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #d5c8a3; /* Bordure dorÃ©e trÃ¨s fine et Ã©lÃ©gante */
    border-radius: 10px;
    margin-top: 24px;  /* Espace pour le titre */
    padding: 24px 20px 16px 20px;
}

QGroupBox:hover {
    border: 1px solid #c78a10; 
    background-color: #ffffff;
}

/* Le "Rectangle" du titre modernisÃ© en style Pilule Premium */
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 20px;
    top: -12px;
    padding: 6px 20px;
    font-weight: 700;
    font-size: 13pt;
    color: #ffffff;             /* Texte blanc pour contraster */
    background-color: #c78a10;  /* Le dorÃ© de votre charte en fond plat */
    border-radius: 8px;         /* Bords arrondis style pilule */
}

/* Effet Hover sur le titre */
QGroupBox::title:hover {
    background-color: #e09f1d;
}

/* =========================================================
   LABELS
   ========================================================= */
QLabel {
    font-weight: 600; /* Semi-bold pour une lecture ultra nette */
    color: #3b3b3b;
}
QLabel#label_formule_rendement {
    color: #7a7a7a;
    font-size: 9pt;
    font-style: italic;
}

/* =========================================================
   LINE EDIT (CHAMPS DE TEXTE) &amp; COMBOBOX
   ========================================================= */
QLineEdit, QComboBox, QDateEdit, QSpinBox, QDoubleSpinBox {
    background-color: #fcfcfc;
    border: 1.5px solid #d2d2d2; /* Bordure discrÃ¨te */
    border-radius: 6px;
    padding: 8px 12px;
    color: #111111;
    font-weight: 500;
}

QLineEdit:hover, QComboBox:hover, QDateEdit:hover {
    border: 1.5px solid #c78a10;
    background-color: #ffffff;
}

QLineEdit:focus, QComboBox:focus, QDateEdit:focus {
    border: 2px solid #c78a10; /* Focus or net */
    background-color: #ffffff;
}

QComboBox::drop-down, QDateEdit::down-button, QDateEdit::up-button {
    subcontrol-origin: padding;
    border-left: 1px solid transparent;
    width: 24px;
    background: transparent;
}
QComboBox:hover::drop-down {
    border-left: 1px solid #f0e4cc;
}
QComboBox::down-arrow {
    width: 14px; height: 14px;
}
QComboBox QAbstractItemView {
    border: 1px solid #c78a10;
    background: #ffffff;
    selection-background-color: #fdf5e6; /* DorÃ© super clair */
    selection-color: #c78a10;
    border-radius: 6px;
}

/* =========================================================
   BOUTONS : DESIGN "GHOST" &amp; SOLID
   ========================================================= */
QPushButton {
    font-weight: 700; /* Texte gras */
    border-radius: 6px; /* Coins modernes */
    padding: 8px 16px;
}

/* --- BOUTONS PRINCIPAUX (SOLID) --- */
/* Bouton "Ajouter" */
QPushButton#ajouter {
    background-color: #4a5c25; /* Vert Olive */
    color: #ffffff;
    border: none;
}
QPushButton#ajouter:hover {
    background-color: #5c7230;
}
QPushButton#ajouter:pressed {
    background-color: #3b491d;
    padding-top: 10px; padding-bottom: 6px;
}

/* Boutons "Chatbot IA" &amp; "Rendement" */
QPushButton#btn_chatbot {
    background-color: #2e7d32;
    color: #ffffff;
    border: none;
}
QPushButton#btn_chatbot:hover {
    background-color: #389e3d;
}
QPushButton#btn_chatbot:pressed {
    padding-top: 10px; padding-bottom: 6px;
}

QPushButton#rendement {
    background-color: #c78a10;
    color: #ffffff;
    border: none;
    font-size: 11pt;
}
QPushButton#rendement:hover {
    background-color: #e09f1d;
}
QPushButton#rendement:pressed {
    padding-top: 10px; padding-bottom: 6px;
}


/* --- BOUTONS SECONDAIRES (GHOST OUTLINE) --- */
/* FantÃ´me dorÃ© pour la modification */
QPushButton#modifier {
    background-color: transparent;
    border: 2px solid #c78a10;
    color: #c78a10;
}
QPushButton#modifier:hover {
    background-color: #c78a10;
    color: #ffffff;
}
QPushButton#modifier:pressed {
    background-color: #a66f08;
    border-color: #a66f08;
}

/* FantÃ´me rouge vif pour suppression */
QPushButton#suprimer {
    background-color: transparent;
    border: 2px solid #d32f2f;
    color: #d32f2f;
}
QPushButton#suprimer:hover {
    background-color: #d32f2f;
    color: #ffffff;
}
QPushButton#suprimer:pressed {
    background-color: #b71c1c;
    border-color: #b71c1c;
}

/* FantÃ´me vert pour Afficher */
QPushButton#afficher {
    background-color: transparent;
    border: 2px solid #4a5c25;
    color: #4a5c25;
}
QPushButton#afficher:hover {
    background-color: #4a5c25;
    color: #ffffff;
}
QPushButton#afficher:pressed {
    background-color: #3b491d;
}

/* Autres petits boutons utilitaires (Gris) */
QPushButton#pushButton_5, QPushButton#pushButton_6, QPushButton#anomalies, QPushButton#graphique, QPushButton#pushButton_recherche, QPushButton#pushButton_effacer_filtre {
    background-color: #ffffff;
    border: 1px solid #dcdcdc;
    color: #555555;
    font-weight: 600;
}
QPushButton#pushButton_5:hover, QPushButton#pushButton_6:hover, QPushButton#anomalies:hover, QPushButton#graphique:hover, QPushButton#pushButton_recherche:hover, QPushButton#pushButton_effacer_filtre:hover {
    background-color: #f0f0f0;
    border-color: #c78a10; /* petit clin d'oeil dorÃ© au survol */
    color: #c78a10;
}

/* =========================================================
   TABLE WIDGET &amp; BARS
   ========================================================= */
QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #fdfdfd;
    gridline-color: #f0e4cc;
    border: 1px solid #e0dfd6;
    border-radius: 8px;
    selection-background-color: #fbf1da; /* DorÃ© pale */
    selection-color: #a66f08; /* Texte foncÃ© pour lisibilitÃ© */
}

QTableWidget::item {
    padding: 8px 6px;
    border-bottom: 1px solid #f6f6f6;
}
QTableWidget::item:hover {
    background-color: #fafbf9;
}

QHeaderView::section {
    background-color: #4a5c25;
    color: #ffffff;
    padding: 10px 8px;
    font-weight: 700;
    font-size: 10pt;
    border: none;
    border-right: 1px solid #5c7230;
}

QScrollBar:vertical {
    background: #f4f5f2;
    width: 10px;
    margin: 2px;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: #c3ccbb; /* Vert olive trÃ¨s pale */
    border-radius: 4px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background: #4a5c25; /* S'assombrit au survol */
}
QScrollBar::add-line, QScrollBar::sub-line {
    background: none;
    height: 0;
}
