}

/* ====== LineEdit ====== */
QLineEdit {
    border: 2px solid #C8A951;
    border-radius: 6px;
    padding: 5px;
    background-color: white;
    min-height: 28px;
}

QLineEdit:focus {
    border: 2px solid #556B2F;
}

/* ====== ComboBox ====== */
QComboBox {
    border: 2px solid #C8A951;
    border-radius: 6px;
    padding: 5px;
    background-color: white;
    min-height: 28px;
}

QComboBox:hover {
    border: 2px solid #556B2F;
}

