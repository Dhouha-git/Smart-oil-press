/* Option : zone du header où se trouve le logo */
QFrame#header {
    background-color: white;
    border-bottom: 1px solid #e0e0e0;
}

/* Style du titre à côté du logo */
QLabel#appTitle {
    color: #556B2F;      /* vert olive */
    font-size: 20px;
    font-weight: bold;
    font-family: Poppins;
}
</string>
