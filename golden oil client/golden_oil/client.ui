      <property name="styleSheet">
       <string notr="true">/* Container général du message IA */
.chat-bubble.ia {
    background-color: #F3F6ED;   /* couleur claire, fond de l'IA */
    color: #2E3B1F;             /* texte vert foncé */
    font-family: 'Segoe UI', sans-serif;
    font-size: 12pt;
    padding: 10px 15px;         /* espace intérieur */
    border-radius: 15px;        /* arrondi des coins */
    margin: 5px 0;              /* espace entre messages */
    max-width: 70%;             /* largeur maximale */
    word-wrap: break-word;      /* retour à la ligne automatique */
    box-shadow: 1px 1px 5px rgba(0,0,0,0.1); /* légère ombre */
}

/* Option pour aligner le message IA à gauche */
.chat-bubble.ia.left {
    margin-left: 10px;
    margin-right: auto;
}

/* Option pour aligner le message IA à droite (ex: messages utilisateur) */
.chat-bubble.ia.right {
    margin-left: auto;
    margin-right: 10px;
    background-color: #D1E8FF;   /* couleur différente pour utilisateur */
    color: #003366;
}
</string>
