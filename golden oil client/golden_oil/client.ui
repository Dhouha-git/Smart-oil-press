label {
    font-family: Arial, sans-serif;
    font-size: 12pt;
    color: #fff; /* texte en blanc pour contraste */
}

input, select, textarea {
    border-radius: 4px;
    border: 1px solid #ccc;
    padding: 3px 5px;
}
