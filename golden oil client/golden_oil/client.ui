    <property name="styleSheet">
     <string notr="true">/* ================= STACKED WIDGET CONTAINER ================= */
QStackedWidget {
    background-color: transparent;
    border-radius: 16px;
}

/* Chaque page du stacked (QWidget interne) */
QStackedWidget &gt; QWidget {
    background-color: #FBFBF8;
    border-radius: 16px;
    border: 2px solid #C9D4B6;
}

/* ================= TITRES DES PAGES ================= */
QLabel#pageTitle {
    color: #556B2F;
    font-size: 16pt;
    font-weight: bold;
    padding-bottom: 8px;
}

/* ================= NAVIGATION (boutons menu gauche ou haut) ================= */
QPushButton#navBtn {
    background-color: transparent;
    color: #2F3E1E;
    border-radius: 10px;
    padding: 8px 14px;
    text-align: left;
    font-weight: 600;
}

/* hover menu */
QPushButton#navBtn:hover {
    background-color: #E8EEDC;
}

/* bouton actif (page courante) */
QPushButton#navBtn:checked {
    background-color: #6B8E23;
    color: white;
}

/* ================= BARRE MENU LATERALE ================= */
QFrame#sideMenu {
    background-color: #EEF3E3;
    border-right: 2px solid #C9D4B6;
    border-radius: 0px;
}

/* icone dans menu */
QPushButton#navBtn::icon {
    padding-left: 5px;
}

/* ================= ANIMATION VISUELLE (effet sélection) ================= */
QPushButton#navBtn:pressed {
    background-color: #556B2F;
    color: white;
}


</string>
    </property>
