 border: 2px solid #FFFFFF; 
    border-radius: 10px;
    padding: 6px 10px;
    font-size: 11pt;
    font-family: Arial;
    selection-background-color: #D4AF37; /* doré */
    selection-color: #000000;
}

QLineEdit:focus {
    border: 2px solid #D4AF37;        /* doré */
    background-color: #FFF8DC;        /* blanc cassé plus lumineux */
}

QLineEdit:hover {
  border: 2px solid #FFFFFF; 
}

QLineEdit:disabled {
    background-color: #e0e0d1;
    color: #888888;
    border: 2px solid #cccccc;
}
QLineEdit::placeholder {
    color: #888888;
    font-style: italic;
}

