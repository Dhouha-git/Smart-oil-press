      <property name="styleSheet">
       <string notr="true">/* ================= BACKGROUND GLOBAL ================= */
QMainWindow {
    background-color: #F4F6EF;
    font-family: &quot;Segoe UI&quot;;
    font-size: 10pt;
}

/* ================= GROUPBOX / PANELS ================= */
QGroupBox {
    background-color: #FBFBF8;
    border: 2px solid #6B8E23;
    border-radius: 14px;
    margin-top: 12px;
    padding: 15px;
}

QGroupBox:title {
    subcontrol-origin: margin;
    left: 15px;
    padding: 2px 10px;
    background-color: #6B8E23;
    color: white;
    border-radius: 8px;
    font-weight: bold;
}

/* ================= LABELS ================= */
QLabel {
    color: #2F3E1E;
    font-weight: 500;
}

/* ================= INPUT FIELDS (ULTRA COMPACT) ================= */
QLineEdit, QTextEdit, QDateEdit, QSpinBox, QComboBox {
    background-color: transparent;
    border: none;
    border-bottom: 2px solid #B7C79A;
    padding: 3px 4px;
    min-height: 22px;
}

QLineEdit:focus, QTextEdit:focus, QDateEdit:focus, QSpinBox:focus, QComboBox:focus {
    border-bottom: 2px solid #6B8E23;
}

/* ================= TABLE / ZONES RESULTATS ================= */
QTableWidget, QTableView, QListWidget, QTextBrowser {
    background-color: white;
    border: 2px solid #C9D4B6;
    border-radius: 12px;
    gridline-color: #E2E8D5;
}

/* Header table */
QHeaderView::section {
    background-color: #6B8E23;
    color: white;
    padding: 4px;
    border: none;
}

/* ================= BUTTONS PRINCIPAUX ================= */
QPushButton {
    background-color: #556B2F;
    color: white;
    border-radius: 12px;
    padding: 6px 18px;
    font-weight: bold;
    min-height: 28px;
}

QPushButton:hover {
    background-color: #6B8E23;
}

QPushButton:pressed {
    background-color: #4C5F28;
}

/* ================= BOUTONS SECONDAIRES (Supprimer / Modifier) ================= */
QPushButton#secondaryBtn {
    background-color: #8FAF3C;
    border-radius: 10px;
}

QPushButton#secondaryBtn:hover {
    background-color: #6B8E23;
}

/* ================= BOUTON EXPORTER ================= */
QPushButton#exportBtn {
    background-color: #3F5122;
    border-radius: 10px;
}

QPushButton#exportBtn:hover {
    background-color: #556B2F;
}

/* ================= PANELS BAS (Assistant / Vérification) ================= */
QFrame#bottomPanel {
    background-color: #6B8E23;
    border-radius: 18px;
    padding: 12px;
}

QFrame#bottomPanel QLabel {
    color: white;
    font-weight: bold;
}

/* zone texte assistant */
QTextEdit#assistantBox {
    background-color: #F8FAF3;
    border-radius: 12px;
    border: 2px solid #556B2F;
}

/* ================= SCROLLBAR MODERNE ================= */
QScrollBar:vertical {
    border: none;
    background: #EEF3E3;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #6B8E23;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #556B2F;
}

</string>
      </property>
