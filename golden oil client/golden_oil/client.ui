      <property name="styleSheet">
       <string notr="true">/* CONTENEUR PRINCIPAL (card) */
QFrame#cardInfo {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 15px;
    padding: 15px;
}

/* TITRE &quot;information&quot; */
QLabel#titleInfo {
    font-size: 16pt;
    font-weight: bold;
    color: #2C3E50;
    padding-bottom: 5px;
}

/* TEXTE DESCRIPTION */
QLabel#description {
    font-size: 12pt;
    color: #444444;
    line-height: 1.4;
}

/* EMAIL */
QLabel#email {
    font-size: 11pt;
    color: #777777;
    margin-top: 10px;
}

/* BOUTON */
QPushButton#btnContact {
    background-color: #D4AF37;   /* doré */
    color: #FFFFFF;
    border: none;
    border-radius: 12px;
    padding: 10px 18px;
    font-size: 11pt;
    font-weight: bold;
}

QPushButton#btnContact:hover {
    background-color: #C49B2C;
}

QPushButton#btnContact:pressed {
    background-color: #A8831F;
}

/* EFFET INPUT / ZONE TEXTE */
QPlainTextEdit {
